From 2ad73ad469a0c313f7e81d614d0793f22122c17d Mon Sep 17 00:00:00 2001
From: ZoeHao2026 <ZoeHao2026@users.noreply.github.com>
Date: Wed, 11 Nov 2026 21:15:19 +0800
Subject: [PATCH] wsl: quiet known-benign PCI/eVMCS/dxg probe messages

---
 arch/x86/kvm/vmx/vmx_onhyperv.c |  2 +-
 arch/x86/pci/common.c           |  2 +-
 arch/x86/pci/init.c             |  4 ++--
 drivers/hv/dxgkrnl/dxgkrnl.h    | 13 +++++++++++++
 drivers/hv/dxgkrnl/ioctl.c      |  4 ++--
 5 files changed, 19 insertions(+), 6 deletions(-)

diff --git a/arch/x86/kvm/vmx/vmx_onhyperv.c b/arch/x86/kvm/vmx/vmx_onhyperv.c
index b9a8b91..0739ad2 100644
--- a/arch/x86/kvm/vmx/vmx_onhyperv.c
+++ b/arch/x86/kvm/vmx/vmx_onhyperv.c
@@ -18,7 +18,7 @@ DEFINE_STATIC_KEY_FALSE(__kvm_is_using_evmcs);
 										\
 		unsupported = vmcs_conf->field & ~EVMCS1_SUPPORTED_ ## ctrl;	\
 		if (unsupported) {						\
-			pr_warn_once(#field " unsupported with eVMCS: 0x%llx\n",\
+			pr_info_once(#field " unsupported with eVMCS: 0x%llx\n",\
 				     (u64)unsupported);				\
 			vmcs_conf->field &= EVMCS1_SUPPORTED_ ## ctrl;		\
 		}								\
diff --git a/arch/x86/pci/common.c b/arch/x86/pci/common.c
index 63105b2..5da5567 100644
--- a/arch/x86/pci/common.c
+++ b/arch/x86/pci/common.c
@@ -501,7 +501,7 @@ void __init pcibios_set_cache_line_size(void)
 int __init pcibios_init(void)
 {
 	if (!raw_pci_ops && !raw_pci_ext_ops) {
-		printk(KERN_WARNING "PCI: System does not support PCI\n");
+		printk(KERN_INFO "PCI: System does not support PCI (expected in WSL)\n");
 		return 0;
 	}
 
diff --git a/arch/x86/pci/init.c b/arch/x86/pci/init.c
index 0bb3b8b..c9875e8 100644
--- a/arch/x86/pci/init.c
+++ b/arch/x86/pci/init.c
@@ -39,8 +39,8 @@ static __init int pci_arch_init(void)
 	pci_direct_init(type);
 
 	if (!raw_pci_ops && !raw_pci_ext_ops)
-		printk(KERN_ERR
-		"PCI: Fatal: No config space access function found\n");
+		printk(KERN_INFO
+		"PCI: no config space access function found (expected in WSL)\n");
 
 	dmi_check_pciprobe();
 
diff --git a/drivers/hv/dxgkrnl/dxgkrnl.h b/drivers/hv/dxgkrnl/dxgkrnl.h
index 09d54bb..7e96137 100644
--- a/drivers/hv/dxgkrnl/dxgkrnl.h
+++ b/drivers/hv/dxgkrnl/dxgkrnl.h
@@ -1071,4 +1071,17 @@ void dxgk_validate_ioctls(void);
 		DXG_TRACE("Ioctl returned: %d", ret);	\
 } while (0)
 
+/*
+ * Query-adapter-info / is-feature-enabled are optional probes; the WSL host
+ * legitimately returns -EINVAL/-ENOENT for information types it does not
+ * implement. Do not log those as errors on every session.
+ */
+#define DXG_TRACE_IOCTL_END_EXPECTED(ret) do {			\
+	if (ret == -EINVAL || ret == -ENOENT || ret == -ENODEV)	\
+		dev_dbg(DXGDEV, "%s: Ioctl returned (expected): %d",	\
+			__func__, ret);					\
+	else							\
+		DXG_TRACE_IOCTL_END(ret);			\
+} while (0)
+
 #endif
diff --git a/drivers/hv/dxgkrnl/ioctl.c b/drivers/hv/dxgkrnl/ioctl.c
index 31bfdcd..7645ee2 100644
--- a/drivers/hv/dxgkrnl/ioctl.c
+++ b/drivers/hv/dxgkrnl/ioctl.c
@@ -668,7 +668,7 @@ cleanup:
 	if (adapter)
 		kref_put(&adapter->adapter_kref, dxgadapter_release);
 
-	DXG_TRACE_IOCTL_END(ret);
+	DXG_TRACE_IOCTL_END_EXPECTED(ret);
 	return ret;
 }
 
@@ -5965,7 +5965,7 @@ cleanup:
 	if (adapter)
 		kref_put(&adapter->adapter_kref, dxgadapter_release);
 
-	DXG_TRACE_IOCTL_END(ret);
+	DXG_TRACE_IOCTL_END_EXPECTED(ret);
 	return ret;
 }
 
-- 
2.53.0

