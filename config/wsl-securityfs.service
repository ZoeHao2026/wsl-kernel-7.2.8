[Unit]
Description=Mount the kernel security file system for WSL
DefaultDependencies=no
After=systemd-remount-fs.service
Before=sysinit.target apparmor.service
ConditionPathExists=/sys/kernel/security

[Service]
Type=oneshot
ExecStart=/bin/mount -t securityfs -o nosuid,nodev,noexec securityfs /sys/kernel/security
RemainAfterExit=yes

[Install]
WantedBy=sysinit.target
