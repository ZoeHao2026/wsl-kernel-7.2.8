[Unit]
Description=zram compressed swap (zstd)
Documentation=man:zramctl(8)
After=systemd-modules-load.service local-fs.target
Before=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes

# zram 是模块（内核 CONFIG_ZRAM=m），先确保加载。
ExecStartPre=-/sbin/modprobe zram
# 残留设备复位；没有设备时 zramctl 返回非 0，用 "-" 前缀忽略。
ExecStartPre=-/usr/sbin/zramctl --reset /dev/zram0
ExecStart=/usr/sbin/zramctl --find --size 1500M --algorithm zstd
# zram 设备初始没有交换签名，必须先写签名再 swapon。
ExecStartPost=/sbin/mkswap /dev/zram0
ExecStartPost=/sbin/swapon --priority 100 /dev/zram0
ExecStop=-/sbin/swapoff /dev/zram0
ExecStopPost=-/usr/sbin/zramctl --reset /dev/zram0

[Install]
# 不要用 swap.target：WSL 每个会话结束会停止 swap.target，
# 导致 zram 被 swapoff/reset，下一次 wsl 命令再重建。
# 挂到 multi-user.target，让它在 VM 生命周期内保持 active。
WantedBy=multi-user.target
