# ============================================================================
# zram 压缩交换设备 —— 本内核已启用 ZRAM_BACKEND_ZSTD，这里把它用起来。
#
# 安装：由 deploy/wsl-env/install.sh 自动完成；手动安装步骤见 README。
#
# 说明
# ----
# 发行版（Ubuntu 26.04）没有预装 systemd 的 zram-generator，所以这里提供的是
# 一个自包含的 systemd 单元，只依赖内核自带的 zram 模块和 util-linux 的
# zramctl（本机已装 /usr/sbin/zramctl）。不引入新的软件包依赖。
#
# 真正的初始化逻辑在 /usr/local/libexec/zram-wsl-setup 里，原因：
#   * WSL 的所有发行版共享同一个内核，swap/zram 是全局状态，不能无条件
#     `zramctl --reset /dev/zram0` 把别的发行版正在用的设备拆掉；
#   * 脚本幂等，重复执行安全；已经有 zram swap 时直接成功退出。
#
# 挂到 multi-user.target 而不是 swap.target：WSL 每个会话结束会停止
# swap.target，挂到那里会导致 zram 被反复 swapoff/reset（实测 dmesg 里
# 出现过 48 次 Removed/Added 循环）。
# ============================================================================
[Unit]
Description=zram compressed swap (zstd)
Documentation=man:zramctl(8)
After=systemd-modules-load.service local-fs.target
Before=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
# 幂等：已有任一 zram swap 就退出；没有则按内存 1/6 建 zstd zram
ExecStart=/usr/local/libexec/zram-wsl-setup

[Install]
WantedBy=multi-user.target
